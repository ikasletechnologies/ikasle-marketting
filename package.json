{
  "name": "ikasle-marketting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build && node scripts/prerender-meta.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=server/.env server/index.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=server/.env server/index.mjs --serve-static",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "export:submissions": "node scripts/export-submissions.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
