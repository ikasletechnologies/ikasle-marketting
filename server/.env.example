# NVIDIA chat (keep the key out of source control)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_BUDGET=64
NVIDIA_TIMEOUT_MS=15000

# SMTP credentials (keep the real values out of source control)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-key

# Mail routing
CONTACT_FROM=ikaslemarketing@gmail.com
CONTACT_RECIPIENT=ikaslemarketing@gmail.com
CAREERS_RECIPIENT=ikaslemarketing@gmail.com
# New newsletter sign-ups are emailed here (defaults to CONTACT_RECIPIENT)
NEWSLETTER_RECIPIENT=ikaslemarketing@gmail.com
CORS_ORIGIN=http://localhost:3045
PORT=5000
# Behind a reverse proxy / load balancer, set true so rate limits use X-Forwarded-For
TRUST_PROXY=false

# Abuse protection (IKAS-403): requests per minute per IP
CHAT_RATE_LIMIT=15
CHAT_MAX_MESSAGE_CHARS=1000
FORM_RATE_LIMIT=5

# Submission storage (IKAS-401). SQLite file is created at $DATA_DIR/ikasle.db
DATA_DIR=server/data

# Production: serve the built site (dist/) from this same server. Defaults to true when NODE_ENV=production.
# SERVE_STATIC=true

# Jira lead triage (IKAS-402). All four must be set to enable it.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
# Enquiries whose budget range starts at or above this amount (INR) create a ticket. 0 = every enquiry.
JIRA_LEAD_MIN_BUDGET=100000
