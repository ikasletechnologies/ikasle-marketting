# NVIDIA chat (keep the key out of source control)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_BUDGET=64
NVIDIA_TIMEOUT_MS=15000

# SMTP credentials (keep the real values out of source control)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-key

# Mail routing
CONTACT_FROM=ikaslemarketing@gmail.com
CONTACT_RECIPIENT=ikaslemarketing@gmail.com
CAREERS_RECIPIENT=ikaslemarketing@gmail.com
CORS_ORIGIN=http://localhost:3045
PORT=5000